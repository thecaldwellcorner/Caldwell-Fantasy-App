# Server
PORT=8080

# Data store: "postgres" to use a real PostgreSQL database, "memory" for the
# in-memory fallback (no DB required; useful for local dev / CI / tests).
DATA_STORE=memory

# PostgreSQL connection (used when DATA_STORE=postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/caldwell

# Optional Redis cache (used when REDIS_URL is set; otherwise an in-memory cache
# is used automatically). Caching is optional and the app runs without it.
# REDIS_URL=redis://localhost:6379

# Cache TTL for hot metrics reads, in seconds.
CACHE_TTL_SECONDS=300

# Trusted data sources
# Sleeper public API base (no key required).
SLEEPER_API_BASE=https://api.sleeper.app/v1
# nflverse-data GitHub release base for nflfastR-style datasets (public CSVs).
NFLVERSE_BASE=https://github.com/nflverse/nflverse-data/releases/download
# Season to ingest weekly metrics for.
SEASON=2024
