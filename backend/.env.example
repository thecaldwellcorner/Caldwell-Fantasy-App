# Server
PORT=8080

# ---------------------------------------------------------------------------
# Data store
# ---------------------------------------------------------------------------
# "supabase" (or "postgres") stores normalized data in Supabase/Postgres.
# "memory" uses a zero-dependency in-memory store (dev / CI / tests).
DATA_STORE=memory

# Supabase is managed Postgres. Use the connection string from
# Supabase → Project Settings → Database (URI). SUPABASE_DB_URL takes precedence,
# otherwise DATABASE_URL is used. This is a SERVER-ONLY secret.
# SUPABASE_DB_URL=postgres://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/caldwell

# Optional Redis cache (falls back to an in-memory TTL cache when unset).
# REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Provider adapters (keys live here ONLY — never in the iOS/Xcode app)
# ---------------------------------------------------------------------------
# Stats provider: "mock" (default), or a licensed feed once configured:
#   "sportsdataio" | "mysportsfeeds" | "sportradar"
# A licensed provider is used only when its API key is present; otherwise the
# mock adapter is used automatically so the service always works.
STATS_PROVIDER=mock
# SPORTSDATAIO_API_KEY=your-server-side-key
SPORTSDATAIO_BASE=https://api.sportsdata.io/v3/nfl

# League provider: "mock" (default) or "sleeper" (free public API, no key).
LEAGUE_PROVIDER=mock
SLEEPER_API_BASE=https://api.sleeper.app/v1

# nflverse-data GitHub release base (used by the legacy metrics pipeline).
NFLVERSE_BASE=https://github.com/nflverse/nflverse-data/releases/download

# Season / week the data layer pulls + serves by default.
SEASON=2024
CURRENT_WEEK=1
