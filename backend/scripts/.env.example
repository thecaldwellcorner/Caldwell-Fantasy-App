# Supabase connection for syncSleeperPlayers.js (SERVER-SIDE ONLY).
# Find these in Supabase → Project Settings → API.
#
# WARNING: SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. Never commit it
# and never embed it in the iOS/Xcode app. It belongs only on the server / in CI.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
