# Copy this file to ".env" and fill in your values.
# Find the Supabase values in: Project Settings -> API.
# Keep the service role key private. Never put it in the iOS app.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Season the import scripts default to (can also pass as an arg, e.g. `node importSchedule.js 2024`).
SEASON=2024

# ---------------------------------------------------------------------------
# Licensed provider adapters (OPTIONAL — leave unset until you have a license).
# Projections and images are NEVER scraped or invented. The import scripts do
# nothing until a provider is configured AND its adapter is implemented.
# These keys are SERVER-SIDE ONLY — never ship them in the iOS app.
# ---------------------------------------------------------------------------
# PROJECTIONS_SOURCE=your-projections-provider
# PROJECTIONS_API_KEY=your-projections-api-key
# IMAGES_PROVIDER=your-image-provider
# IMAGES_API_KEY=your-image-api-key
